# Template file for 'chatgpt'
# Repackages OpenAI's official Codex desktop app .deb; checksums come from
# OpenAI's GPG-signed apt index (github.com/sinapirani/claude-codex-desktop-linux).
pkgname=chatgpt
version=26.1103.60933
revision=1
archs="x86_64 aarch64"
depends="alsa-lib atk at-spi2-atk at-spi2-core cairo dbus-libs eudev-libudev
 expat gdk-pixbuf glib gtk+3 libcrypto3 libcups libgbm libGL libnotify libusb
 libX11 libxcb libXcomposite libXdamage libXext libXfixes libxkbcommon
 libXrandr nspr nss pango tpm2-tss xdg-utils xz"
short_desc="Codex desktop app by OpenAI (official ChatGPT build, repackaged)"
maintainer="Sina Pirani <sinapiranidev@gmail.com>"
license="custom:Proprietary"
homepage="https://developers.openai.com/codex/app"
_repo="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt"

case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="${_repo}/chatgpt_${version}_amd64.deb"
	checksum=0746e9ba575182f5dbe32617b82a645eb93ad57ca588e5a9358695a6b65aee71
	;;
aarch64)
	distfiles="${_repo}/chatgpt_${version}_arm64.deb"
	checksum=6db19a845591d509e9b83cb0a8e0b4a22dee27448d211c1d1fa8a4fb92edcc5d
	;;
*)
	broken="No distfiles available for this target"
	;;
esac

repository=nonfree
restricted=yes
nostrip=yes
nopie=yes
# The bundle carries prebuilt Node modules for other platforms (musl, Android,
# ARM) and optional Qt shims; their sonames must not become dependencies, and
# its private libraries must not be offered to other packages. The runtime
# dependencies are listed above instead.
noverifyrdeps=yes
noshlibprovides=yes
# the .deb has a single top-level usr/ (+ etc/); keep it instead of stripping it
create_wrksrc=yes

do_install() {
	# Only usr/: etc/ holds just an AppArmor profile for Ubuntu.
	vcopy usr /
	rm -rf ${DESTDIR}/usr/share/lintian ${DESTDIR}/usr/share/doc
	vlicense usr/share/doc/chatgpt/copyright
}
